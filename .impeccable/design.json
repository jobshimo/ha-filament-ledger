  "narrative": {
    "northStar": "The Workshop Ledger",
    "overview": "The panel is a precision instrument for a maker's bench: slate surfaces, one cool teal light, and figures set like gauge readings. It carries its own palette, type and motion, inside a shadow root HA's styling cannot reach. Numbers are the hero; colour is reserved for state.",
    "keyCharacteristics": [
      "One accent (teal) plus three state colours.",
      "Semantic token names.",
      "Tabular monospaced numerals.",
      "44px minimum tap target.",
      "Layout answers the panel's own width."
    ],
    "rules": [
      {
        "name": "The One Light Rule",
        "body": "Teal is the only brand colour and marks interactive or live things; if something is teal it can be acted on or is current.",
        "section": "colors"
      },
      {
        "name": "The Honest State Rule",
        "body": "Green, amber and coral appear only when the ledger asserts that state. They are never used for decoration.",
        "section": "colors"
      },
      {
        "name": "The Mirror Rule",
        "body": "The light variant remaps every token (accent becomes #006e63, bg #f4f6f8, surface #ffffff, ink #233646); no component may hard-code a colour outside the token set.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any number that can be compared or summed is monospaced with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Decoration Is Mute Rule",
        "body": "Ambient motes, the dashed strand and the card sweep never carry data and are hidden when prefers-reduced-motion is set or the panel is narrow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read every colour, radius and duration from the --fl-* tokens.",
      "Do use --fl-tap (44px) as the floor for tappable targets.",
      "Do ask the container (@container panel), not the viewport.",
      "Do keep copy and any new string in English, Spanish and Turkish together."
    ],
    "donts": [
      "Don't add a framework, bundler or build step to the panel (ADR-0006).",
      "Don't use literal colour names or hard-coded hex values in components.",
      "Don't use teal for non-interactive decoration, or state colours for emphasis.",
      "Don't let ambient decoration run under reduced motion."
    ]
  }
